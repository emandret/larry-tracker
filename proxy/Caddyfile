# The stack's only published service: serves the static map page and routes
# the page's API and WebSocket calls to location-service.
#
#   /api/*      -> location-service, with the /api prefix stripped
#                  (/api/trips -> /trips, /api/locations/5 -> /locations/5)
#   /ws         -> location-service's WebSocket (upgrades are proxied automatically)
#   /config.js  -> runtime settings for the page, from this container's env
#   /healthz    -> liveness check for the proxy itself
#   everything else -> static files in /srv (proxy/site/ in the repo)
#
# Plain HTTP on :80 inside the container; docker-compose publishes it on 8000.
:80 {
    handle_path /api/* {
        reverse_proxy location-service:8001
    }

    handle /ws {
        reverse_proxy location-service:8001
    }

    # The CARTO key is visible in the page anyway (a client-side quota id, not
    # a secret), so serving it here exposes nothing new.
    handle /config.js {
        header Content-Type "text/javascript; charset=utf-8"
        header Cache-Control "no-store"
        respond `window.LARRY_CONFIG = { cartoApiKey: "{env.CARTO_API_KEY}" };` 200
    }

    handle /healthz {
        header Content-Type "application/json"
        respond `{"status": "ok"}` 200
    }

    handle {
        # A stale cached page after a deploy is a footgun for a live
        # dashboard, so never let the browser cache it.
        header Cache-Control "no-store"
        root * /srv
        file_server
    }
}
